container_commands:
  00-composer:
    command: "composer install --no-scripts | tee -a /var/log/composer.log && composer dump-autoload | tee -a /var/log/composer.log && composer update | tee -a /var/log/composer.log"
  01-clear-cache:
    command: "php artisan config:clear && php artisan route:clear && php artisan view:clear"
  02-optimize:
    command: "php artisan config:cache && php artisan route:cache && php artisan view:cache"
